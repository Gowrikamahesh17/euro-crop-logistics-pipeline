# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
.venv/
venv/
ENV/
env/

# Environment variables, credentials & secrets
.env
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log

# Datasets (large files & generated data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.tsv
*.parquet

# Serialized ML models & checkpoints (models/*.joblib kept: needed by the deployed dashboard)
*.pkl

*.h5
*.pt
*.pth
*.onnx

# Evaluation reports are committed so the Streamlit Cloud dashboard has data
!reports/*.csv

# Jupyter Notebook checkpoints & autogenerated assets
.ipynb_checkpoints/
*-checkpoint.ipynb

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*

# VS Code & IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace